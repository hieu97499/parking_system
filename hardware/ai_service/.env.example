# =============================================
# AI Service – cấu hình cho máy camera riêng
# Sao chép file này thành .env rồi chỉnh lại
# =============================================

# --- Kết nối tới backend (production server) ---
BACKEND_URL=https://baixethongminh.duckdns.org
HARDWARE_API_KEY=parking_hw_secret_change_this

# --- Server AI lắng nghe ---
AI_HOST=0.0.0.0
AI_PORT=5001

# --- Camera index (0, 1, 2, 3...) ---
# Kiểm tra thứ tự camera bằng lệnh: python -c "import cv2; [print(i, cv2.VideoCapture(i).isOpened()) for i in range(5)]"
ENTRY_PLATE_CAM=0
ENTRY_FACE_CAM=1
EXIT_PLATE_CAM=2
EXIT_FACE_CAM=3

# --- Độ phân giải và FPS ---
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15

# --- Thư mục lưu ảnh tạm (nếu upload backend thất bại) ---
