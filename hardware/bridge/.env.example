# Serial ports – xem trong Device Manager
ENTRY_SERIAL_PORT=COM3
EXIT_SERIAL_PORT=COM4
SERIAL_BAUD=9600

# AI Service
AI_SERVICE_URL=http://localhost:5001
AI_TIMEOUT_MS=10000

# Backend – nếu chạy máy riêng, trỏ vào production server
# BACKEND_URL=https://baixethongminh.duckdns.org
BACKEND_URL=http://localhost:4000
HARDWARE_API_KEY=parking_hw_secret_change_this

# AI Service
AI_SERVICE_URL=http://localhost:5001
AI_TIMEOUT_MS=10000

# ─── ESP8266 via I2C (không cần cổng COM) ───────────────────────────
# Bridge lắng nghe TCP trên cổng này – ESP8266 kết nối đến
ESP8266_TCP_PORT=4003

# Device UUID từ bảng devices trong database
# Lấy bằng cách chạy: SELECT device_id, device_name FROM devices;
ENTRY_DEVICE_ID=
EXIT_DEVICE_ID=

# ─── Serial COM (chỉ cần nếu KHÔNG dùng ESP8266) ────────────────────
# ENTRY_SERIAL_PORT=COM6
# EXIT_SERIAL_PORT=COM11
# SERIAL_BAUD=9600

# WebSocket server (real-time cho Admin Web)
WS_PORT=4002

# ID thiết bị (phải trùng với device_id trong bảng devices)
ENTRY_DEVICE_ID=1
EXIT_DEVICE_ID=2

# Debounce (ms): tránh xử lý liên tục khi sensor dao động
DEBOUNCE_MS=3000
